# Anthropic API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Claude model for the three short checks (scope, advice topic, interpreting a
# typed answer). Optional: defaults to claude-sonnet-5-5. Change it here when a
# model is retired, not in code. The checks turn thinking off with
# { type: 'between_tools' }, which claude-sonnet-5-5 needs and other models may
# refuse: if you change the model, change NO_THINKING in lib/claudeClassifiers.ts too.
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional: Google Sheets integration for data capture
# GOOGLE_SHEETS_ID=your_sheet_id
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Live read of the platform (plan B1a). Off unless set to "platform".
# VA_SERVICE_SOURCE=platform
# The VA's own read-only database user. Never commit the value.
# MONGODB_URI=
